<?xml version="1.0" encoding="utf-8"?>
<!-- AndrOS mobil — altta sekmeler: Ana sayfa · Kumanda · Ayarlar.
     Sekmeler ayrı ekran açmıyor, aynı pencerede sayfa değiştiriyor:
     bağlantı ve eşleştirme durumu geçişte kaybolmasın. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_home" />

        <include layout="@layout/page_phone" />

        <include layout="@layout/page_control" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_variant" />

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/tabHome"
            style="@style/TabItem">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/tab_home" />
            <TextView style="@style/TabLabel" android:text="@string/tab_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPhone"
            style="@style/TabItem">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_phone"
                android:contentDescription="@string/tab_phone" />
            <TextView style="@style/TabLabel" android:text="@string/tab_phone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabControl"
            style="@style/TabItem">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_control"
                android:contentDescription="@string/tab_control" />
            <TextView style="@style/TabLabel" android:text="@string/tab_control" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            style="@style/TabItem">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
            <TextView style="@style/TabLabel" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
