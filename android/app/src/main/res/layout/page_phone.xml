<?xml version="1.0" encoding="utf-8"?>
<!-- Telefon: tuş takımı + rehber. Aramayı ve mesajı telefonun kendi
     hattı yapıyor; internet üzerinden arama ayrı bir katman olacak. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pagePhone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_phone"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phoneModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/contacts"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tuş takımı -->
    <LinearLayout
        android:id="@+id/keypadBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/dialField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/code_bg"
            android:gravity="center"
            android:hint="@string/number"
            android:inputType="phone"
            android:letterSpacing="0.08"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="26sp"
            android:autofillHints="phone" />

        <TextView
            android:id="@+id/dialMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <GridLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:columnCount="3"
            android:rowCount="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dialMessage"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/message" />

            <Button
                android:id="@+id/dialCall"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:text="@string/call" />

            <Button
                android:id="@+id/dialSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rehber -->
    <LinearLayout
        android:id="@+id/contactsBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/contactSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/code_bg"
            android:hint="@string/search_contacts"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="14sp"
            android:autofillHints="" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contactList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/addContact"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_contact" />
    </LinearLayout>
</LinearLayout>
